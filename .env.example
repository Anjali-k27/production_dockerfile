# Copy this file to .env before `docker run --env-file .env` / `bash verify.sh`.
# The demo defaults below are the same ones used through Week 16 — they need no
# real provider keys (the cluster's `litellm` is a mock), so the values here
# are safe to use as-is for local runs. Rotate JWT_SECRET before any real
# deployment: anyone who reads the Week 16 source already knows the default.

# JWT — must match epoch_gateway/epoch_auth.py and the Week 16 test fixtures
JWT_SECRET=epoch-demo-secret-rotate-via-kms-in-prod
JWT_ISSUER=https://idp.epoch.internal
JWT_AUDIENCE=epoch-gateway.internal

# LLM backend — container-name DNS on the cluster backplane, never localhost
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=epoch-litellm-key

# "active" (default) enforces the cross-tenant hospital_id check.
EPOCH_TENANT_ISOLATION=active
